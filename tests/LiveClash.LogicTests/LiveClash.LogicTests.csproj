<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless regression runner for the Revit-FREE logic. Runs on a build machine with NO Revit
    installed. The code under test is ..\LiveClash.Logic (the Revit-free Core files, compiled on
    their own); the assertions live once, in ..\..\Testing\*Checks.cs, shared with the in-Revit
    checks through SharedChecks.

        dotnet run  (from this project folder)      exit code = failed-check count; CI gates on it
        dotnet test                                  the same checks as one MSTest test, which is how
                                                     Stryker.NET (ci\mutation.ps1) drives them

    GenerateProgramFile=false keeps OUR Main: the test SDK would otherwise generate an entry point
    of its own, and `dotnet run` would stop printing the per-check lines.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The headless suite also runs on .NET Framework 4.8, the runtime of Revit 2024 (ci\gate.ps1, not -Quick): -p:LcNet48=true -->
    <TargetFramework Condition="'$(LcNet48)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(LcNet48)' == 'true'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LiveClash.LogicTests</AssemblyName>
    <RootNamespace>LiveClash.LogicTests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);REVIT2025;R24_PLUS;LOGICTESTS_HEADLESS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveClash.Logic\LiveClash.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runner, and the MSTest wrapper over the same list. -->
    <Compile Include="Program.cs" />
    <Compile Include="SharedChecksTest.cs" />

    <!-- Shared assertions (single source of truth, also run by the in-Revit checks).
         SharedChecks is the one list both tiers run; add a block there, not here. -->
    <Compile Include="..\..\Testing\SharedChecks.cs" Link="Shared\SharedChecks.cs" />
    <Compile Include="..\..\Testing\FilterLogicChecks.cs" Link="Shared\FilterLogicChecks.cs" />
    <Compile Include="..\..\Testing\FilterMatchChecks.cs" Link="Shared\FilterMatchChecks.cs" />
