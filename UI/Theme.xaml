<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================ palette
       One place for the whole add-in's Fluent-flat look, shared by the panel,
       the filter window and the audit window so they read as one tool. -->

  <SolidColorBrush x:Key="Bg"          Color="#FBFBFC"/>
  <SolidColorBrush x:Key="Card"        Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ToolbarBg"   Color="#F3F4F6"/>
  <SolidColorBrush x:Key="StatusBg"    Color="#F7F8FA"/>
  <SolidColorBrush x:Key="Hairline"    Color="#E6E8EC"/>
  <SolidColorBrush x:Key="Divider"     Color="#EDEFF2"/>
  <SolidColorBrush x:Key="RowHover"    Color="#F5F8FD"/>

  <SolidColorBrush x:Key="Text"        Color="#1F2430"/>
  <SolidColorBrush x:Key="TextSec"     Color="#5A6270"/>
  <SolidColorBrush x:Key="TextMut"     Color="#858C99"/>

  <SolidColorBrush x:Key="Accent"      Color="#2C63C9"/>
  <SolidColorBrush x:Key="AccentHover" Color="#2557B4"/>
  <SolidColorBrush x:Key="AccentSoft"  Color="#EAF1FC"/>
  <SolidColorBrush x:Key="AccentText"  Color="#2C63C9"/>

  <SolidColorBrush x:Key="BtnBorder"   Color="#D6DAE1"/>
  <SolidColorBrush x:Key="BtnHover"    Color="#F1F3F6"/>

  <!-- controls inside the windows: check boxes, drop-downs, scroll bars, selected rows -->
  <SolidColorBrush x:Key="CheckBorder"      Color="#AEB6C2"/>
  <SolidColorBrush x:Key="BtnBorderHover"   Color="#AAB2BF"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#C9CED7"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#A5ADBA"/>
  <SolidColorBrush x:Key="SelectBg"         Color="#E3ECFA"/>
  <SolidColorBrush x:Key="SelectHoverBg"    Color="#D9E6F9"/>

  <!-- The system's own selection colours, redefined for every window that uses this theme. Controls
       that keep their stock template (text selection in a text box, the corner where two scroll bars
       meet) read these, so they follow the palette instead of the user's Windows accent colour. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"                     Color="#FBFBFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                   Color="#2C63C9"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"               Color="#FFFFFF"/>

  <!-- surfaces and states that used to be hard-coded in the styles below -->
  <SolidColorBrush x:Key="HeaderBg"      Color="#F5F6F8"/>
  <SolidColorBrush x:Key="TickTint"      Color="#F1F6FD"/>
  <SolidColorBrush x:Key="GridLine"      Color="#F0F1F4"/>
  <SolidColorBrush x:Key="BtnPressed"    Color="#E7EAEF"/>
  <SolidColorBrush x:Key="BtnDisabledBg" Color="#F6F7F8"/>
  <SolidColorBrush x:Key="GhostHover"    Color="#ECEEF1"/>
  <SolidColorBrush x:Key="TrackBg"       Color="#E6E9EF"/>

  <!-- the scope hint beside the Full check button -->
  <SolidColorBrush x:Key="ScopeGreen"  Color="#2E7D32"/>
  <SolidColorBrush x:Key="ScopeAmber"  Color="#C97A0A"/>
  <SolidColorBrush x:Key="ScopeRed"    Color="#C0392B"/>

  <!-- clash-type chips -->
  <SolidColorBrush x:Key="ThroughBg"   Color="#FAE7E0"/>
  <SolidColorBrush x:Key="ThroughFg"   Color="#933A1C"/>
  <SolidColorBrush x:Key="EndsInBg"    Color="#FAEBCF"/>
  <SolidColorBrush x:Key="EndsInFg"    Color="#805009"/>
  <SolidColorBrush x:Key="InsideBg"    Color="#DFF3EB"/>
  <SolidColorBrush x:Key="InsideFg"    Color="#0E6A52"/>

  <!-- ============================================================ buttons -->
  <Style x:Key="LcButton" TargetType="Button">
    <Setter Property="Height" Value="27"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="{DynamicResource Card}"
                  BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LcPrimaryButton" TargetType="Button" BasedOn="{StaticResource LcButton}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="{DynamicResource Accent}"
                  BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ list header -->
  <Style x:Key="LcHeader" TargetType="{x:Type GridViewColumnHeader}">
    <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
          <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a compact clash-type chip; the color is set by the caller via DataTriggers -->
  <Style x:Key="LcChip" TargetType="Border">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ghost button: quiet actions (Import, Export, Cancel) -->
  <Style x:Key="LcGhostButton" TargetType="Button" BasedOn="{StaticResource LcButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="Transparent" BorderThickness="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource GhostHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
  </Style>

  <!-- flat text box -->
  <Style x:Key="LcTextBox" TargetType="TextBox">
    <Setter Property="Height" Value="27"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="5" Background="{DynamicResource Card}"
                  BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a flat, rounded progress bar (determinate) -->
  <Style x:Key="LcProgressBar" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="{DynamicResource TrackBg}"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- soft "reads as" panel -->
  <SolidColorBrush x:Key="ReadsBg"     Color="#F3F6FB"/>
  <SolidColorBrush x:Key="ReadsBorder" Color="#E1E8F3"/>
  <SolidColorBrush x:Key="ReadsLabel"  Color="#8AA0C4"/>
  <SolidColorBrush x:Key="ReadsText"   Color="#3E4757"/>
  <SolidColorBrush x:Key="GroupBg"     Color="#F5F7FE"/>
  <SolidColorBrush x:Key="GroupBorder" Color="#D6DCF5"/>
  <SolidColorBrush x:Key="GroupText"   Color="#4550A0"/>

  <!-- ============================================================ controls inside the windows
       Everything below is IMPLICIT (no x:Key on the style itself, or a key only where a template is
       shared), so a control dropped into any window that merges this dictionary is themed without
       anyone having to remember to ask. The brushes are looked up dynamically so a palette swap
       reaches them. -->

  <!-- check box: a rounded box, filled with the accent when ticked -->
  <ControlTemplate x:Key="LcCheckBoxTemplate" TargetType="CheckBox">
    <Grid Background="Transparent" SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
              Background="{DynamicResource Card}" BorderBrush="{DynamicResource CheckBorder}" BorderThickness="1.5">
        <Grid>
          <Path x:Name="tick" Data="M0,4 L3,7 L8.5,0.5" Stroke="White" StrokeThickness="1.9"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <Rectangle x:Name="dash" Width="7" Height="2" RadiusX="1" RadiusY="1" Fill="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
        <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}">
        <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
        <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="LcCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Padding" Value="7,0,0,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template" Value="{StaticResource LcCheckBoxTemplate}"/>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource LcCheckBox}"/>

  <!-- the tick column of a data grid: keeps the grid's own click-and-focus behaviour, changes only the look -->
  <Style x:Key="LcGridCheckBox" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultElementStyle}">
    <Setter Property="Template" Value="{StaticResource LcCheckBoxTemplate}"/>
  </Style>
  <Style x:Key="LcGridCheckBoxEditing" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultEditingElementStyle}">
    <Setter Property="Template" Value="{StaticResource LcCheckBoxTemplate}"/>
  </Style>

  <!-- scroll bars: a thin rounded thumb on a transparent track, no arrow buttons -->
  <Style x:Key="LcScrollPage" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LcScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="th" Margin="2" CornerRadius="3" Background="{DynamicResource ScrollThumb}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="th" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="th" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="LcScrollVertical" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource LcScrollPage}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource LcScrollThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource LcScrollPage}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="LcScrollHorizontal" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Track x:Name="PART_Track" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource LcScrollPage}" Command="ScrollBar.PageLeftCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource LcScrollThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource LcScrollPage}" Command="ScrollBar.PageRightCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template" Value="{StaticResource LcScrollVertical}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template" Value="{StaticResource LcScrollHorizontal}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- combo box: the same flat box as the text box, a small chevron, and a rounded drop-down -->
  <ControlTemplate x:Key="LcComboToggle" TargetType="ToggleButton">
    <Border x:Name="bd" CornerRadius="5" SnapsToDevicePixels="True"
            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
      <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSec}" StrokeThickness="1.4"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BtnBorderHover}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,0,28,0"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <ToggleButton x:Name="Toggle" Template="{StaticResource LcComboToggle}" Focusable="False" ClickMode="Press"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Focusable="True" Background="Transparent"
                     BorderThickness="0" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                     IsReadOnly="{TemplateBinding IsReadOnly}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" Focusable="False"
                   AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource Card}" BorderBrush="{DynamicResource BtnBorder}"
                      BorderThickness="1" CornerRadius="6" Padding="3" SnapsToDevicePixels="True">
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- rows of a list: a soft hover and a soft selection, no system-blue block -->
  <Style TargetType="ListViewItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,2"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectHoverBg}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- expander: a small chevron that turns, instead of the round button -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <DockPanel>
              <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Focusable="True" Cursor="Hand"
                            Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,4" SnapsToDevicePixels="True">
                      <DockPanel LastChildFill="True">
                        <Path x:Name="chevron" DockPanel.Dock="Left" Data="M0,0 L4,4 L0,8" Width="5" Height="9"
                              Margin="5,0,9,0" Stroke="{DynamicResource TextMut}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                          </Path.RenderTransform>
                        </Path>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource AccentText}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="chevron" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90"/>
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- right-click menu -->
  <Style TargetType="ContextMenu">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource BtnBorder}"
                  BorderThickness="1" CornerRadius="6" Padding="4" SnapsToDevicePixels="True">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" CornerRadius="4" Background="Transparent" Padding="10,6,14,6" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="26,0,0,0"
                         Foreground="{DynamicResource TextMut}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMut}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{DynamicResource Divider}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- hover tip: a small flat card that wraps long text instead of running off the screen -->
  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="MaxWidth" Value="380"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource BtnBorder}"
                  BorderThickness="1" CornerRadius="5" Padding="9,6" SnapsToDevicePixels="True">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
