<Window x:Class="LiveClash.UI.AssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign"
        Width="520" Height="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True" Margin="16,14,16,14">

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
            Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel LastChildFill="False">
        <Button x:Name="AssignButton" DockPanel.Dock="Right" Style="{StaticResource LcPrimaryButton}" Content="Assign" Width="100" Height="31"
                Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Cancel" Width="90" Height="31" IsCancel="True"/>
      </DockPanel>
    </Border>

    <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <StackPanel x:Name="PendingPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,10">
      <TextBlock x:Name="PendingHeading" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource EndsInFg}"/>
      <ItemsControl x:Name="PendingList" Margin="12,3,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}" Margin="0,1"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" Style="{StaticResource LcTextBox}" Padding="8,0,8,0" TextChanged="Search_Changed"/>
      <TextBlock x:Name="SearchHint" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,8,0"
                 Foreground="{DynamicResource TextMut}" Text="Search names&#8230;"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="Other name" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSec}"/>
        <TextBox x:Name="OtherBox" Style="{StaticResource LcTextBox}" TextChanged="Other_Changed"
                 ToolTip="Someone who has not touched this model yet. It is only a label."/>
      </DockPanel>
      <TextBlock x:Name="OtherHint" Margin="0,4,0,0" Foreground="{DynamicResource EndsInFg}" FontSize="11"/>
      <TextBlock x:Name="ProblemText" Margin="0,4,0,0" Foreground="{DynamicResource ScopeRed}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>

    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="7" ClipToBounds="True"
            Background="{DynamicResource Card}">
      <ListBox x:Name="NameList" BorderThickness="0" Background="{DynamicResource Card}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="Name_Changed" MouseDoubleClick="Name_DoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource TextMut}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
