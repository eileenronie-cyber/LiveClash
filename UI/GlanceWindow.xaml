<Window x:Class="LiveClash.UI.GlanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash at a glance"
        Width="440" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Everything below binds to properties on the window itself, because the
       code-behind sets DataContext = this. {Binding Foo} therefore reads this.Foo. -->
  <DockPanel LastChildFill="True" Margin="14">

    <!-- header: a summary line that updates itself through a bound property -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Clash at a glance" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding SeverityLine}" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0"/>
      <CheckBox Content="Hard clashes only"
                IsChecked="{Binding HardOnly, Mode=TwoWay}"
                Margin="0,8,0,0" FontSize="12"/>
    </StackPanel>

    <!-- footer buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource LcButton}" Content="Refresh" Width="90" Height="31" Margin="0,0,8,0" Click="Refresh_Click"/>
      <Button Style="{StaticResource LcButton}" Content="Close" Width="90" Height="31" IsCancel="True"/>
    </StackPanel>

    <!-- the list fills itself from the bound Rows collection; each row uses the template -->
    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="7"
            Background="{DynamicResource Card}" ClipToBounds="True">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Rows}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2,4,2,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                           FontWeight="SemiBold" MinWidth="40" TextAlignment="Right"
                           Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
