<Window x:Class="LiveClash.UI.ValueBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse values"
        Width="660" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True" Margin="14">

    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}" Margin="0,0,0,10" LineHeight="18">
      The distinct values actually present in this model, with how many elements carry each.
      Tick the ones this side should match. Matching is exact, so picking from here can never
      mistype a value.
    </TextBlock>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSec}"/>
      <TextBox x:Name="SearchBox" Style="{StaticResource LcTextBox}" TextChanged="Search_Changed"/>
    </DockPanel>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
            Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSec}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcPrimaryButton}" Content="Add picked" Width="110" Height="31"
                Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Cancel" Width="90" Height="31" IsCancel="True"/>
        <Button x:Name="RescanButton" DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Rescan" Width="90" Height="31"
                Margin="0,0,8,0" Click="Rescan_Click"
                ToolTip="Read the model again - the list is cached between openings"/>
      </DockPanel>
    </Border>

    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="7" ClipToBounds="True"
            Background="{DynamicResource Card}">
      <ListBox x:Name="ValueList" BorderThickness="0" Background="{DynamicResource Card}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3">
              <StackPanel>
                <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMut}" FontSize="11"/>
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
