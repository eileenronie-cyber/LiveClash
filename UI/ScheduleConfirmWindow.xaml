<Window x:Class="LiveClash.UI.ScheduleConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="520" SizeToContent="Height" MaxHeight="620" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True" Margin="16,14,16,14">

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
            Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel LastChildFill="False">
        <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource LcPrimaryButton}" Width="120" Height="31"
                Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Cancel" Width="90" Height="31" IsCancel="True"/>
      </DockPanel>
    </Border>

    <CheckBox x:Name="TickBox" DockPanel.Dock="Bottom" Margin="0,12,0,0"
              Checked="Tick_Changed" Unchecked="Tick_Changed"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ItemsControl x:Name="LinesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" LineHeight="17"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
