<Window x:Class="LiveClash.UI.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LiveClash.UI"
        Title="Live Clash — record"
        Width="1140" Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True" Margin="14">

    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}" Margin="0,0,0,10" LineHeight="18">
      Every clash pair someone decided about — <Bold>Pending</Bold>, <Bold>Coordinated</Bold>,
      <Bold>Ignored</Bold> — and every pair the tool re-tested and found gone
      (<Bold>Resolved</Bold>). Click a row to select the elements. There is no manual
      "Resolved": a fix stops being found and is recorded here on its own.
    </TextBlock>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSec}"/>
      <ComboBox x:Name="StateFilter" Width="150" Height="27" VerticalContentAlignment="Center"
                SelectionChanged="Filter_Changed" VerticalAlignment="Center"/>
      <TextBlock Text="Search" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{DynamicResource TextSec}"/>
      <TextBox x:Name="SearchBox" Style="{StaticResource LcTextBox}" TextChanged="Search_Changed"/>
    </DockPanel>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
            Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSec}"/>
        <!-- Click, not IsCancel alone. IsCancel closes a MODAL window by setting
             DialogResult; this window is opened with Show(), not ShowDialog(), so there
             is no dialog result to set and the button did nothing at all. IsCancel stays
             for the Escape key, which routes through the same handler. -->
        <Button DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Close" Width="90" Height="31"
                IsCancel="True" Click="Close_Click"/>
        <Button x:Name="RecheckButton" DockPanel.Dock="Right" Style="{StaticResource LcButton}"
                Content="Recheck record" Width="130" Height="31"
                Margin="0,0,8,0" Click="Recheck_Click"
                ToolTip="Re-test every pair in this record — including ones that dropped out of the live results — and retire any that have since been fixed."/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Export full record…" Width="150" Height="31"
                Margin="0,0,8,0" Click="Export_Click"
                ToolTip="Write the whole record — all four states — to a CSV the meeting can open"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Open folder" Width="100" Height="31"
                Margin="0,0,8,0" Click="OpenFolder_Click"/>
      </DockPanel>
    </Border>

    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="7" ClipToBounds="True"
            Background="{DynamicResource Card}">
      <ListView x:Name="RecordList" BorderThickness="0" Background="{DynamicResource Card}"
                SelectionChanged="List_SelectionChanged"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

        <!-- Grouped by day, newest first. A flat ledger answers "what was decided";
             grouping by day answers "what was decided since the last coordination
             meeting", which is the question anyone actually opens this to ask.
             Headers are collapsible, so an old day folds away.

             Grouped on WhenDayKey (negated ticks) rather than the WhenDay label:
             grouping on the text would order the headings alphabetically and put
             "Fri 29 Aug" above "Today". The header still SHOWS the label. -->
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                      <Expander IsExpanded="True" Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Hairline}"
                                BorderThickness="0,0,0,1">
                        <Expander.Header>
                          <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Margin="2,0,10,0"
                                       Text="{Binding Items[0].WhenDay}"/>
                            <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource TextMut}"
                                       Text="{Binding ItemCount, StringFormat={}{0} decision(s)}"/>
                          </DockPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </ListView.GroupStyle>

        <ListView.View>
          <!-- Widths sum to what fits the default window (1140) without a horizontal
               scrollbar, with room for a vertical one. Before, the columns were 1174 wide in a 960 window and "By" and "Note" were
               cut off at the right edge. -->
          <GridView ColumnHeaderContainerStyle="{StaticResource LcHeader}">
            <GridViewColumn Header="" Width="24">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="10" Height="10" Fill="{Binding Dot}" ToolTip="{Binding StateText}"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="State" Width="90" DisplayMemberBinding="{Binding StateText}"/>
            <GridViewColumn Header="When" Width="100" DisplayMemberBinding="{Binding WhenText}"/>
            <!-- Age, not just date. A Pending decision three weeks old is a different
                 thing from this morning's, and a timestamp does not say so at a glance. -->
            <GridViewColumn Header="Age" Width="85" DisplayMemberBinding="{Binding AgeText}"/>
                      <GridViewColumn Header="Element" Width="210">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding HostText}" Margin="2,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding HostText}" ui:TruncationTip.OnlyWhenCut="True"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
                      <GridViewColumn Header="Clashed with" Width="210">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding OtherText}" Margin="2,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding OtherText}" ui:TruncationTip.OnlyWhenCut="True"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
                      <GridViewColumn Header="Model" Width="120">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ModelName}" Margin="2,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ModelName}" ui:TruncationTip.OnlyWhenCut="True"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
                      <GridViewColumn Header="By" Width="80">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding By}" Margin="2,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding By}" ui:TruncationTip.OnlyWhenCut="True"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
                      <GridViewColumn Header="Note" Width="150">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Note}" Margin="2,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Note}" ui:TruncationTip.OnlyWhenCut="True"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
  </DockPanel>
</Window>
