<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================ dark palette
       The SAME keys as the palette at the top of Theme.xaml, with dark values. ThemeManager merges this
       dictionary AFTER Theme.xaml into a window that should be dark, so it wins for every key it defines,
       and takes it out again for a light one. Every brush in the windows is looked up dynamically, so the
       swap reaches windows that are already open.

       A key added to the palette in Theme.xaml must be added here: a test compares the two key sets, and
       another walks every window rendered dark for a colour that is still the light theme's. -->

  <SolidColorBrush x:Key="Bg"          Color="#26292E"/>
  <SolidColorBrush x:Key="Card"        Color="#2E3238"/>
  <SolidColorBrush x:Key="ToolbarBg"   Color="#2B2F35"/>
  <SolidColorBrush x:Key="StatusBg"    Color="#24272C"/>
  <SolidColorBrush x:Key="Hairline"    Color="#3C424B"/>
  <SolidColorBrush x:Key="Divider"     Color="#363B43"/>
  <SolidColorBrush x:Key="RowHover"    Color="#343A43"/>

  <SolidColorBrush x:Key="Text"        Color="#E7E9ED"/>
  <SolidColorBrush x:Key="TextSec"     Color="#B0B7C3"/>
  <SolidColorBrush x:Key="TextMut"     Color="#8A92A0"/>

  <SolidColorBrush x:Key="Accent"      Color="#3A6FD8"/>
  <SolidColorBrush x:Key="AccentHover" Color="#2F62C7"/>
  <SolidColorBrush x:Key="AccentSoft"  Color="#2A3A5C"/>
  <SolidColorBrush x:Key="AccentText"  Color="#8DB4FF"/>

  <SolidColorBrush x:Key="BtnBorder"   Color="#4A505A"/>
  <SolidColorBrush x:Key="BtnHover"    Color="#3A3F47"/>

  <SolidColorBrush x:Key="CheckBorder"      Color="#7A8290"/>
  <SolidColorBrush x:Key="BtnBorderHover"   Color="#8B93A1"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#565D68"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#737B88"/>
  <SolidColorBrush x:Key="SelectBg"         Color="#2F4570"/>
  <SolidColorBrush x:Key="SelectHoverBg"    Color="#38548A"/>

  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"                     Color="#26292E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                   Color="#3A6FD8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"               Color="#FFFFFF"/>

  <SolidColorBrush x:Key="HeaderBg"      Color="#2B2F35"/>
  <SolidColorBrush x:Key="TickTint"      Color="#2B3852"/>
  <SolidColorBrush x:Key="GridLine"      Color="#363B43"/>
  <SolidColorBrush x:Key="BtnPressed"    Color="#434952"/>
  <SolidColorBrush x:Key="BtnDisabledBg" Color="#2A2D33"/>
  <SolidColorBrush x:Key="GhostHover"    Color="#3A3F47"/>
  <SolidColorBrush x:Key="TrackBg"       Color="#3C424B"/>

  <SolidColorBrush x:Key="ThroughBg"   Color="#4B2B23"/>
  <SolidColorBrush x:Key="ThroughFg"   Color="#F3A88F"/>
  <SolidColorBrush x:Key="EndsInBg"    Color="#4A3A1B"/>
  <SolidColorBrush x:Key="EndsInFg"    Color="#EDBF63"/>
  <SolidColorBrush x:Key="InsideBg"    Color="#1F4034"/>
  <SolidColorBrush x:Key="InsideFg"    Color="#72D6B4"/>

  <SolidColorBrush x:Key="ReadsBg"     Color="#2A2F38"/>
  <SolidColorBrush x:Key="ReadsBorder" Color="#384050"/>
  <SolidColorBrush x:Key="ReadsLabel"  Color="#8FA4CC"/>
  <SolidColorBrush x:Key="ReadsText"   Color="#C5CCD8"/>
  <SolidColorBrush x:Key="GroupBg"     Color="#2B2F45"/>
  <SolidColorBrush x:Key="GroupBorder" Color="#3F4775"/>
  <SolidColorBrush x:Key="GroupText"   Color="#A3AEF0"/>

  <SolidColorBrush x:Key="ScopeGreen"  Color="#66BB6A"/>
  <SolidColorBrush x:Key="ScopeAmber"  Color="#F0A83A"/>
  <SolidColorBrush x:Key="ScopeRed"    Color="#EF6B5E"/>

</ResourceDictionary>
