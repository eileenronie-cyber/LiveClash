<Window x:Class="LiveClash.UI.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note"
        Width="520" Height="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True" Margin="14">
    <TextBlock x:Name="PromptText" DockPanel.Dock="Top" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSec}" Margin="0,0,0,10"/>

    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMut}" FontSize="11"
                   Text="Leave empty to clear the note."/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcPrimaryButton}" Content="Save" Width="90" Height="31"
                Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Cancel" Width="90" Height="31" IsCancel="True"/>
      </DockPanel>
    </Border>

    <TextBox x:Name="NoteBox" Style="{StaticResource LcTextBox}" AcceptsReturn="False"
             VerticalAlignment="Top"/>
  </DockPanel>
</Window>
