<Window x:Class="LiveClash.UI.RefreshPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refresh clash markers"
        Width="580" SizeToContent="Height" MaxHeight="720" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveClash;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True" Margin="16,14,16,14">

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
            Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="FooterText" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   Foreground="{DynamicResource TextSec}" FontSize="11"/>
        <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{StaticResource LcPrimaryButton}" Width="130" Height="31"
                Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource LcButton}" Content="Cancel" Width="90" Height="31" IsCancel="True"/>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Border x:Name="RefusalBox" Visibility="Collapsed" Padding="10,7" Margin="0,0,0,10" CornerRadius="6"
                Background="{DynamicResource EndsInBg}">
          <TextBlock x:Name="RefusalText" TextWrapping="Wrap" Foreground="{DynamicResource EndsInFg}" FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="CapBox" Visibility="Collapsed" Padding="10,7" Margin="0,0,0,10" CornerRadius="6"
                Background="{DynamicResource EndsInBg}">
          <TextBlock x:Name="CapText" TextWrapping="Wrap" Foreground="{DynamicResource EndsInFg}" FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="WarnBox" Visibility="Collapsed" Padding="10,7" Margin="0,0,0,10" CornerRadius="6"
                Background="{DynamicResource EndsInBg}">
          <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="{DynamicResource EndsInFg}"/>
        </Border>

        <TextBlock x:Name="NothingText" Visibility="Collapsed" Margin="0,0,0,8" FontWeight="SemiBold"
                   Foreground="{DynamicResource Accent}"/>

        <StackPanel x:Name="AddsPanel" Visibility="Collapsed" Margin="0,0,0,10">
          <TextBlock x:Name="AddsHeading" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ItemsControl x:Name="AddsList" Margin="12,3,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="ShowingPanel" Visibility="Collapsed" Margin="0,0,0,10">
          <TextBlock x:Name="ShowingHeading" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ItemsControl x:Name="ShowingList" Margin="12,3,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Card}"
                Padding="12,8" Grid.IsSharedSizeScope="True">
          <ItemsControl x:Name="LinesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Count"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Count}" HorizontalAlignment="Right" MinWidth="40" FontWeight="SemiBold" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" MinWidth="86" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <CheckBox x:Name="RetentionCheck" Visibility="Collapsed" Margin="0,12,0,0"
                  Checked="Retention_Changed" Unchecked="Retention_Changed"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
